{
  "name": "app-grupo-la-paz",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma Grupo La Paz: portal de empresas afiliadas, portal de clientes y panel de administración",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrar": "prisma migrate deploy",
    "db:demo": "tsx prisma/seed.ts",
    "db:produccion": "tsx prisma/produccion.ts",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "setup:produccion": "prisma migrate deploy && tsx prisma/produccion.ts",
    "importar": "tsx scripts/importar.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.28",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
