# --- Base de datos ---
# Demo: SQLite local. Producción: cambiar provider a "postgresql" en prisma/schema.prisma
# y poner aquí la URL de Postgres (Supabase, Neon, RDS, etc.)
DATABASE_URL="file:./demo.db"

# --- Sesiones ---
# Cadena aleatoria larga (mínimo 32 caracteres). Generar con: openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-una-cadena-aleatoria-larga-de-48-caracteres"

# --- URL pública de la app (para links en correos) ---
APP_URL="http://localhost:3000"

# --- WhatsApp de atención (formato internacional, solo dígitos) ---
WHATSAPP_NUMERO="523121223211"

# --- n8n ---
# Webhook de n8n que recibe los eventos (códigos de activación, recuperación de contraseña,
# solicitudes de cita). Si se deja vacío la app corre en MODO DEMO: los códigos y links
# se muestran en pantalla en lugar de enviarse.
N8N_WEBHOOK_URL=""
# Secreto compartido que la app envía en el header "x-lapaz-signature" para que n8n valide el origen
N8N_WEBHOOK_SECRET=""
