# ─── Base de datos: Neon (PostgreSQL) ───
# En neon.tech → tu proyecto → "Connect":
#   DATABASE_URL = cadena con "-pooler" en el host (la usa la app)
#   DIRECT_URL   = la misma cadena SIN "-pooler" (la usan las migraciones)
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Sesiones ───
# Cadena aleatoria larga (mínimo 32 caracteres). Generar con: openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-una-cadena-aleatoria-larga-de-48-caracteres"

# ─── URL pública de la app (para los enlaces de recuperación) ───
APP_URL="http://localhost:3000"

# ─── WhatsApp de atención (formato internacional, solo dígitos) ───
WHATSAPP_NUMERO="523121223211"

# ─── Administrador inicial (solo lo usa `npm run db:produccion`) ───
ADMIN_EMAIL=""
ADMIN_NOMBRE="Administración La Paz"
ADMIN_PASSWORD=""

# ─── n8n ───
# Webhook de n8n que recibe los eventos (códigos de activación, recuperación de contraseña,
# solicitudes de cita). Vacío = MODO DEMO: los códigos y enlaces se muestran en pantalla.
N8N_WEBHOOK_URL=""
# Secreto compartido; la app lo usa para firmar el header "x-lapaz-signature"
N8N_WEBHOOK_SECRET=""
